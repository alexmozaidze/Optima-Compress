import { Theme } from "theme.slint";
import { ClipData, ClipState, EncodingOptions, EncodingField } from "clip-model.slint";
import { DropTarget } from "components/drop-target.slint";
import { VideoList } from "components/video-list.slint";
import { SelectionSettings } from "components/selection-settings.slint";

export component AppWindow inherits Window {
    callback files-dropped(data-transfer);

    title: "QuickClip Compress";
    background: Theme.window-bg;
    preferred-width: 1141px;
    preferred-height: 762px;
    min-width: 320px;
    min-height: 400px;
    default-font-family: "Open Sans";
    default-font-size: 13px;

    property <bool> tablet: root.width < 800px * (root.default-font-size / 13px);
    property <bool> phone: root.width < 480px * (root.default-font-size / 13px);

    out property <int> selected-count: video-list.selected-count;
    out property <bool> mixed-options: video-list.mixed-options;
    in-out property <int> codec: 1;
    in-out property <int> size: 0;
    in-out property <string> custom-size: "8";
    in-out property <int> resolution: 1;
    in-out property <string> custom-width: "1920";
    in-out property <string> custom-height: "1080";
    in-out property <bool> track-game: true;
    in-out property <bool> track-mic: true;
    in-out property <bool> track-party: false;

    out property <EncodingOptions> default-options: {
        codec: 1, size: 0, custom-size: "8", resolution: 1,
        custom-width: "1920", custom-height: "1080",
        track-game: true, track-mic: true, track-party: false,
    };

    in-out property <[ClipData]> clips: [
        {
            file-name: "ShadowPlay_Clip_01.mp4", source-path: "",
            metadata: "2:45 · 1080p · 142 MB", state: ClipState.waiting,
            progress: 0, selected: false, options: root.default-options,
        },
        {
            file-name: "Ranked_Highlights.mp4", source-path: "",
            metadata: "1:12 · 1080p · 86 MB", state: ClipState.compressing,
            progress: 0.58, selected: false, options: root.default-options,
        },
        {
            file-name: "Aces_Round_5.mp4", source-path: "",
            metadata: "0:30 · 720p · 18 MB", state: ClipState.finished,
            progress: 1, selected: false, options: root.default-options,
        },
    ];

    header := Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: Math.max(26px, window-title.preferred-height + 10px);
        background: Theme.header-bg;

        window-title := Text {
            text: "QuickClip Compress";
            color: Theme.text;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.divider;
        }
    }

    video-list := VideoList {
        x: 0px;
        y: header.height;
        width: root.width;
        height: root.height - header.height;
        clips <=> root.clips;
        phone: root.phone;
        bottom-inset: root.selected-count > 0 || video-list.selecting ? settings-panel.height + 24px : 0px;
        selection-changed(options) => {
            if root.selected-count == 0 { return; }
            root.codec = options.codec;
            root.size = options.size;
            root.custom-size = options.custom-size;
            root.resolution = options.resolution;
            root.custom-width = options.custom-width;
            root.custom-height = options.custom-height;
            root.track-game = options.track-game;
            root.track-mic = options.track-mic;
            root.track-party = options.track-party;
        }
    }

    settings-panel := SelectionSettings {
        x: root.phone ? 8px : 21px;
        y: root.height - self.height - 12px;
        width: root.width - 2 * self.x;
        height: Math.min(self.preferred-height, (root.height - header.height) * 0.55);
        visible: root.selected-count > 0 && !video-list.selecting;
        selected-count: root.selected-count;
        mixed-options: root.mixed-options;
        tablet: root.tablet;
        phone: root.phone;
        codec <=> root.codec;
        size <=> root.size;
        custom-size <=> root.custom-size;
        resolution <=> root.resolution;
        custom-width <=> root.custom-width;
        custom-height <=> root.custom-height;
        track-game <=> root.track-game;
        track-mic <=> root.track-mic;
        track-party <=> root.track-party;
        option-edited(field) => {
            video-list.edit-options(field, {
                codec: root.codec, size: root.size, custom-size: root.custom-size,
                resolution: root.resolution, custom-width: root.custom-width, custom-height: root.custom-height,
                track-game: root.track-game, track-mic: root.track-mic, track-party: root.track-party,
            });
        }
        clear-selection => { video-list.clear-selection(); }
    }

    window-drop := DropTarget {
        width: root.width;
        height: root.height;
        files-dropped(data) => { root.files-dropped(data); }
    }
}
