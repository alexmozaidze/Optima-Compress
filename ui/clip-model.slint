export enum ClipState {
    waiting,
    compressing,
    finished,
}

export enum EncodingField {
    codec,
    frame-rate,
    custom-frame-rate,
    size,
    custom-size,
    resolution,
    custom-width,
    custom-height,
}

export struct EncodingOptions {
    codec: int,
    frame-rate: int,
    custom-frame-rate: string,
    size: int,
    custom-size: string,
    resolution: int,
    custom-width: string,
    custom-height: string,
}

export struct EncodingConflicts {
    codec: bool,
    frame-rate: bool,
    custom-frame-rate: bool,
    size: bool,
    custom-size: bool,
    resolution: bool,
    custom-width: bool,
    custom-height: bool,
}

export struct AudioTrack {
    name: string,
    info: string,
    enabled: bool,
}

export struct ClipData {
    file-name: string,
    source-path: string,
    metadata: string,
    state: ClipState,
    progress: float,
    selected: bool,
    audio-tracks: [AudioTrack],
    options: EncodingOptions,
}

export enum SelectionOperation {
    click,
    box,
    clear,
    cancel,
    edit,
    edit-audio,
}

export struct SelectionRequest {
    operation: SelectionOperation,
    gesture: int,
    index: int,
    anchor: int,
    control: bool,
    shift: bool,
    origin: Point,
    position: Point,
    field: EncodingField,
    options: EncodingOptions,
    audio-track-index: int,
    audio-track-enabled: bool,
}
