import { Theme } from "../theme.slint";
import { CheckSquare } from "check-box.slint";

export component AudioTrackRow inherits Rectangle {
    in property <int> track-number;
    in property <string> track-name;
    in property <string> track-format;
    in-out property <bool> enabled;
    in property <bool> compact;

    min-height: root.compact ? 66px : 41px;
    vertical-stretch: 0;
    background: row-touch.has-hover ? Theme.segment-hover : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 11px;

        VerticalLayout {
            alignment: center;
            CheckSquare {
                checked <=> root.enabled;
                interactive: false;
            }
        }
        Text {
            text: "\{root.track-number}";
            width: 11px;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
        FlexboxLayout {
            width: root.width - 76px;
            flex-direction: root.compact ? column : row;
            flex-wrap: no-wrap;
            spacing: root.compact ? 4px : 11px;
            horizontal-stretch: 1;

            Text {
                width: root.compact ? root.width - 76px : Math.max(0px, root.width - 87px - format-text.preferred-width);
                text: root.track-name;
                color: Theme.text;
                font-size: 13px;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            format-text := Text {
                width: root.compact ? root.width - 76px : self.preferred-width;
                text: root.track-format;
                color: Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
    }

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.enabled = !root.enabled; }
    }
}
