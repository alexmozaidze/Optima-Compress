import { Theme } from "../theme.slint";
import { ClipState } from "../clip-model.slint";

component VideoThumb inherits Rectangle {
    in property <ClipState> state: ClipState.waiting;

    border-radius: 8px;
    background: Theme.window-bg;

    Image {
        width: 32px;
        height: 32px;
        source: root.state == ClipState.compressing ? @image-url("../icons/progress-circle.svg")
            : @image-url("../icons/play-circle.svg");
        image-rendering: smooth;
        colorize: root.state == ClipState.finished ? Theme.success
            : root.state == ClipState.compressing ? Theme.accent : Theme.text;
    }
}

component EncodingSummary inherits HorizontalLayout {
    in property <string> codec;
    in property <string> resolution;
    in property <string> target-size;

    min-width: 0px;
    spacing: 14px;

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;

        Image {
            width: 20px;
            height: 20px;
            source: @image-url("../icons/arrow-right.svg");
            image-rendering: smooth;
            colorize: Theme.text-dim;
        }
    }
    VerticalLayout {
        min-width: 0px;
        preferred-width: 0px;
        horizontal-stretch: 1;
        alignment: center;
        spacing: 4px;

        Text {
            text: root.codec + " · " + root.resolution;
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: root.target-size + " target";
            color: Theme.text-dim;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

export component ClipRow inherits Rectangle {
    in property <string> file-name;
    in property <string> metadata;
    in property <string> encoding-codec;
    in property <string> encoding-resolution;
    in property <string> encoding-size;
    in property <ClipState> state: ClipState.waiting;
    in property <float> progress: 0;
    in property <bool> phone;
    in property <bool> selected;

    accessible-role: list-item;
    accessible-label: root.file-name;
    accessible-item-selected: root.selected;

    property <float> bounded-progress: Math.max(0, Math.min(1, root.progress));
    property <color> status-color: root.state == ClipState.finished ? Theme.success
        : root.state == ClipState.compressing ? Theme.accent : Theme.text-dim;

    background: Theme.card-bg;
    border-radius: 7.7px;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width * (root.state == ClipState.finished ? 1 : root.bounded-progress);
        height: root.height;
        visible: root.state != ClipState.waiting;
        background: root.state == ClipState.finished ? Theme.success.with-alpha(0.12) : Theme.accent.with-alpha(0.20);
        border-radius: root.border-radius;
        border-top-right-radius: root.state == ClipState.finished || root.bounded-progress >= 1 ? root.border-radius : 0px;
        border-bottom-right-radius: self.border-top-right-radius;
    }

    HorizontalLayout {
        min-width: 0px;
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;

            VideoThumb {
                width: root.phone ? 80px : 112px;
                height: self.width * 9 / 16;
                state: root.state;
            }
        }
        details := VerticalLayout {
            min-width: 0px;
            preferred-width: 0px;
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            Text {
                height: self.preferred-height;
                text: root.file-name;
                color: Theme.text;
                font-size: 16px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                height: self.preferred-height;
                text: root.metadata;
                color: Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 7px;

                if root.state != ClipState.compressing : VerticalLayout {
                    alignment: center;

                    Image {
                        width: 12px;
                        height: 12px;
                        source: root.state == ClipState.finished ? @image-url("../icons/check-circle.svg")
                            : @image-url("../icons/clock.svg");
                        image-rendering: smooth;
                        colorize: root.status-color;
                    }
                }
                Text {
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    text: root.state == ClipState.finished ? "Ready to copy"
                        : root.state == ClipState.compressing ? "Compressing · " + Math.round(root.bounded-progress * 100) + "%"
                        : "Waiting for compression";
                    color: root.status-color;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }

            if root.phone : EncodingSummary {
                codec: root.encoding-codec;
                resolution: root.encoding-resolution;
                target-size: root.encoding-size;
            }
        }
        if !root.phone : EncodingSummary {
            preferred-width: 0px;
            horizontal-stretch: 1;
            codec: root.encoding-codec;
            resolution: root.encoding-resolution;
            target-size: root.encoding-size;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Rectangle {
                width: 24px;
                height: 24px;

                Image {
                    width: 16px;
                    height: 16px;
                    source: @image-url("../icons/more.svg");
                    image-rendering: smooth;
                    colorize: Theme.text;
                }
            }
        }
    }

    selection-highlight := Rectangle {
        width: root.width;
        height: root.height;
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Theme.accent;
        background: Theme.accent.with-alpha(0.05);
        opacity: root.selected ? 1 : 0;

        animate opacity { duration: 160ms; easing: ease-out; }
    }
}
