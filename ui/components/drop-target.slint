import { Theme } from "../theme.slint";

export component DropTarget inherits DropArea {
    callback files-dropped(data-transfer);

    can-drop(event) => { DragAction.copy }
    dropped(event) => {
        root.files-dropped(event.data);
        return DragAction.copy;
    }

    if root.has-drag : Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.window-bg.with-alpha(0.92);
        border-width: 2px;
        border-color: Theme.accent;

        Text {
            x: 21px;
            width: parent.width - 42px;
            text: "Drop video files to add them";
            color: Theme.accent;
            font-size: 20px;
            font-weight: 600;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
