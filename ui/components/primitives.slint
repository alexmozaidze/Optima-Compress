import { Theme } from "../theme.slint";

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

export component ClickFocusArea inherits TouchArea {
    focus-target := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
    }

    pointer-event(event) => {
        if event.kind == PointerEventKind.down {
            focus-target.focus();
        }
    }
}

export component Tick inherits Path {
    in property <float> scale: 1;
    property <float> safe-scale: Math.max(root.scale, 0.001);

    width: 100%;
    height: 100%;
    viewbox-x: (24 - 24 / root.safe-scale) / 2;
    viewbox-y: (24 - 24 / root.safe-scale) / 2;
    viewbox-width: 24 / root.safe-scale;
    viewbox-height: 24 / root.safe-scale;
    commands: "M 6 12 L 10 16.5 L 18 7.5";
    fill: transparent;
    stroke: Theme.text-on-accent;
    stroke-width: 1.4px * root.safe-scale;
}
