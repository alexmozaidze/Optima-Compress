import { Theme } from "../theme.slint";

export component SectionLabel inherits Text {
    min-width: 0px;
    preferred-width: 0px;

    color: Theme.text-dim;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.7px;
    height: Math.max(15px, self.preferred-height);
    vertical-alignment: center;
}

export component SettingColumn inherits VerticalLayout {
    in property <string> title;

    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;

    SectionLabel {
        text: root.title;
    }
    Rectangle { height: 7.7px; }

    @children
}

export component InlineLabel inherits Text {
    color: Theme.text-dim;
    font-size: 12px;
    height: Theme.field-height;
    vertical-alignment: center;
}

export component NumberField inherits Rectangle {
    in-out property <string> value;
    in property <length> field-width: 62px;

    width: field-width;
    height: Theme.field-height;
    border-radius: Theme.radius-control;
    background: Theme.field-bg;
    border-width: 1px;
    border-color: Theme.outline;

    TextInput {
        x: 5px;
        y: 0;
        width: parent.width - 10px;
        height: parent.height;
        text <=> root.value;
        color: Theme.text;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Reveal inherits Rectangle {
    in property <bool> shown;

    min-width: 0px;
    preferred-width: 0px;
    height: root.shown ? Theme.field-height + 8px : 0px;
    clip: true;

    animate height { duration: 200ms; easing: ease-in-out; }

    HorizontalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 7px;

        @children
    }
}
