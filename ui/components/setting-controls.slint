import { Theme } from "../theme.slint";

export component SectionLabel inherits Text {
    min-width: 0px;
    preferred-width: 0px;

    color: Theme.text-dim;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.7px;
    height: Math.max(15px, self.preferred-height);
    vertical-alignment: center;
}

export component SettingColumn inherits VerticalLayout {
    in property <string> title;
    out property <length> header-height: column-label.height + label-gap.height;

    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;

    column-label := SectionLabel {
        text: root.title;
    }
    label-gap := Rectangle { height: 7.7px; }

    @children
}

export component InlineLabel inherits Text {
    color: Theme.text-dim;
    font-size: 0.92rem;
    height: Theme.field-height;
    vertical-alignment: center;
}

export component AttachedDetailBackground inherits Rectangle {
    in property <length> detail-width;
    in property <length> header-height;

    Rectangle {
        x: root.width - root.detail-width;
        width: root.detail-width;
        height: root.height;
        background: Theme.segment-bg;
        border-radius: Theme.radius-segment;
        border-top-left-radius: 0px;
    }

    Rectangle {
        x: root.width - root.detail-width - Theme.radius-segment;
        y: 0px;
        width: 2 * Theme.radius-segment;
        height: root.header-height + Theme.radius-segment;
        background: Theme.segment-bg;
        clip: true;

        Rectangle {
            x: -Theme.radius-segment;
            y: root.header-height;
            width: 2 * Theme.radius-segment;
            height: self.width;
            border-radius: Theme.radius-segment;
            background: Theme.window-bg;
        }
    }
}

export component InputGroup inherits Rectangle {
    in property <bool> focused;

    horizontal-stretch: 0;
    height: Theme.field-height + 20px;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 12px;

        Rectangle {
            height: Theme.field-height;
            border-radius: Theme.radius-control;
            background: Theme.field-bg;
            border-width: 1px;
            border-color: root.focused ? Theme.accent : transparent;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;

                @children
            }
        }
    }
}

export component NumberField inherits TextInput {
    in-out property <string> value <=> root.text;
    in property <length> field-width: 62px;

    width: root.field-width;
    height: Theme.field-height;
    color: Theme.text;
    font-size: 1rem;
    horizontal-alignment: center;
    vertical-alignment: center;
}

export component Reveal inherits Rectangle {
    in property <bool> shown;

    min-width: 0px;
    preferred-width: 0px;
    height: root.shown ? Theme.field-height + 20px : 0px;
    clip: true;

    animate height { duration: 200ms; easing: ease-in-out; }

    HorizontalLayout {
        alignment: end;
        spacing: 0px;

        @children
    }
}
