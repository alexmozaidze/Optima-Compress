import { Theme } from "../theme.slint";
import { AudioTrack, ClipData, ClipState, EncodingOptions, EncodingConflicts, EncodingField, EncodingPresets, SelectionRequest, SelectionOperation } from "../clip-model.slint";
import { SelectableClip } from "selectable-clip.slint";
import { ScrollRail } from "scroll-rail.slint";
import { ClickFocusArea } from "primitives.slint";
import { ScrollView } from "std-widgets.slint";

export component VideoList inherits Rectangle {
    in-out property <[ClipData]> clips;
    in property <bool> phone;
    out property <bool> selecting;
    out property <int> selected-count;
    out property <[AudioTrack]> audio-tracks;
    out property <int> selection-revision;
    out property <EncodingConflicts> option-conflicts;
    out property <bool> mixed-options: root.option-conflicts.codec || root.option-conflicts.size || root.option-conflicts.custom-size
        || root.option-conflicts.frame-rate || root.option-conflicts.custom-frame-rate
        || root.option-conflicts.resolution || root.option-conflicts.custom-width || root.option-conflicts.custom-height;
    callback selection-changed(EncodingOptions);
    callback copy-requested(string);
    callback add-videos-requested;

    property <bool> marquee-active;
    property <length> rows-inset: 14px;
    property <bool> has-anchor;
    property <int> anchor;
    property <SelectionRequest> request;
    property <int> request-revision;
    property <int> reported-count;
    property <int> pending-selected-count;
    property <int> first-selected;
    property <EncodingConflicts> pending-conflicts;
    property <EncodingOptions> pending-options;
    property <[AudioTrack]> pending-audio-tracks;

    pure function conflicts-with(options: EncodingOptions) -> EncodingConflicts {
        return {
            codec: root.pending-conflicts.codec || options.codec != root.pending-options.codec,
            frame-rate: root.pending-conflicts.frame-rate || options.frame-rate != root.pending-options.frame-rate,
            custom-frame-rate: root.pending-conflicts.custom-frame-rate || options.custom-frame-rate != root.pending-options.custom-frame-rate,
            size: root.pending-conflicts.size || options.size != root.pending-options.size,
            custom-size: root.pending-conflicts.custom-size || options.custom-size != root.pending-options.custom-size,
            resolution: root.pending-conflicts.resolution || options.resolution != root.pending-options.resolution,
            custom-width: root.pending-conflicts.custom-width || options.custom-width != root.pending-options.custom-width,
            custom-height: root.pending-conflicts.custom-height || options.custom-height != root.pending-options.custom-height,
        };
    }

    function dispatch() {
        root.reported-count = 0;
        root.pending-selected-count = 0;
        root.pending-audio-tracks = [];
        root.pending-conflicts = {
            codec: false, size: false, custom-size: false, resolution: false,
            frame-rate: false, custom-frame-rate: false,
            custom-width: false, custom-height: false,
        };
        root.request-revision += 1;
        if root.clips.length == 0 {
            root.selected-count = 0;
            root.audio-tracks = [];
            root.option-conflicts = root.pending-conflicts;
            root.selection-revision += 1;
        }
    }

    function report-row(index: int, selected: bool, options: EncodingOptions, audio-tracks: [AudioTrack]) {
        if selected {
            if root.pending-selected-count > 0 { root.pending-conflicts = root.conflicts-with(options); }
            if audio-tracks.length > root.pending-audio-tracks.length { root.pending-audio-tracks = audio-tracks; }
            if root.pending-selected-count == 0 || index < root.first-selected {
                root.first-selected = index;
                root.pending-options = options;
            }
            root.pending-selected-count += 1;
        }
        root.reported-count += 1;
        if root.reported-count == root.clips.length {
            root.selected-count = root.pending-selected-count;
            root.audio-tracks = root.pending-audio-tracks;
            root.option-conflicts = root.pending-conflicts;
            root.selection-changed(root.pending-options);
            root.selection-revision += 1;
        }
    }

    function begin-selection(index: int, has-target: bool, position: Point, modifiers: KeyboardModifiers) {
        list-focus.focus();
        root.selecting = true;
        root.marquee-active = false;
        root.request.gesture += 1;
        root.request.operation = SelectionOperation.click;
        root.request.has-target = has-target;
        root.request.index = index;
        root.request.anchor = root.has-anchor ? root.anchor : index;
        root.request.control = modifiers.control;
        root.request.shift = modifiers.shift;
        root.request.origin = position;
        root.request.position = position;
        if has-target && (!modifiers.shift || !root.has-anchor) { root.has-anchor = true; root.anchor = index; }
        if !has-target && !modifiers.control && !modifiers.shift { root.has-anchor = false; }
        root.dispatch();
    }

    function move-selection(position: Point) {
        if !root.selecting { return; }
        root.request.position = position;
        if root.marquee-active || Math.abs(position.x - root.request.origin.x) > 4px || Math.abs(position.y - root.request.origin.y) > 4px {
            root.marquee-active = true;
            root.request.operation = SelectionOperation.box;
            root.dispatch();
        }
    }

    function finish-selection() {
        root.selecting = false;
        root.marquee-active = false;
    }

    function cancel-selection() {
        root.finish-selection();
        root.request.operation = SelectionOperation.cancel;
        root.dispatch();
    }

    public function clear-selection() {
        root.has-anchor = false;
        root.request.operation = SelectionOperation.clear;
        root.dispatch();
    }

    public function delete-clip(index: int) {
        if index < 0 || index >= root.clips.length { return; }
        if root.has-anchor && root.anchor == index { root.has-anchor = false; }
        if root.has-anchor && root.anchor > index { root.anchor -= 1; }
        root.clips.remove(index);
        // NOTE: deferring lets the repeated rows rebind before they report, otherwise the deleted row's stale report corrupts the aggregate.
        refresh-timer.start();
    }

    public function compress-clip(index: int) {
        if index < 0 || index >= root.clips.length { return; }
        root.clips[index].state = ClipState.compressing;
        root.clips[index].progress = 0;
    }

    public function cancel-clip(index: int) {
        if index < 0 || index >= root.clips.length { return; }
        root.clips[index].state = ClipState.waiting;
        root.clips[index].progress = 0;
    }

    public function edit-options(field: EncodingField, options: EncodingOptions) {
        root.request.operation = SelectionOperation.edit;
        root.request.field = field;
        root.request.options = options;
        root.dispatch();
    }

    public function edit-audio(index: int, enabled: bool) {
        root.request.operation = SelectionOperation.edit-audio;
        root.request.audio-track-index = index;
        root.request.audio-track-enabled = enabled;
        root.dispatch();
    }

    list-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.clear-selection();
                return accept;
            }
            return reject;
        }
    }

    refresh-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.request.operation = SelectionOperation.refresh;
            root.dispatch();
        }
    }

    list-scroll := ScrollView {
        width: root.width;
        height: root.height;
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: always-off;
        mouse-drag-pan-enabled: false;
        content-width: self.visible-width;
        content-height: Math.max(self.visible-height, list-rows.min-height + 2 * root.rows-inset);

        list-surface := Rectangle {
            width: list-scroll.visible-width;
            height: list-scroll.content-height;

            selection-touch := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.begin-selection(0, false, { x: self.mouse-x, y: self.mouse-y }, event.modifiers);
                    }
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.left { root.finish-selection(); }
                    if event.kind == PointerEventKind.cancel { root.cancel-selection(); }
                }
                moved => { root.move-selection({ x: self.mouse-x, y: self.mouse-y }); }
            }

            list-rows := VerticalLayout {
                x: Theme.video-list-inset;
                y: root.rows-inset;
                width: list-surface.width - 2 * Theme.video-list-inset;
                height: self.min-height;
                spacing: 8px;

                for clip[index] in root.clips : SelectableClip {
                    width: list-rows.width;
                    index: index;
                    list-offset: { x: list-rows.x, y: list-rows.y };
                    phone: root.phone;
                    file-name: clip.file-name;
                    metadata: clip.metadata;
                    state: clip.state;
                    progress: clip.progress;
                    selected: clip.selected;
                    options: clip.options;
                    audio-tracks: clip.audio-tracks;
                    audio-revision: root.selection-revision;
                    request: root.request;
                    request-revision: root.request-revision;
                    encoding-codec: EncodingPresets.codec-format(clip.options);
                    encoding-frame-rate: EncodingPresets.frame-rate-format(clip.options);
                    encoding-resolution: EncodingPresets.resolution-format(clip.options);
                    encoding-size: EncodingPresets.size-format(clip.options);
                    pointer-pressed(index, position, modifiers) => { root.begin-selection(index, true, position, modifiers); }
                    pointer-moved(position) => { root.move-selection(position); }
                    pointer-released => { root.finish-selection(); }
                    pointer-cancelled => { root.cancel-selection(); }
                    row-updated(index, selected, options) => {
                        clip.selected = selected;
                        clip.options = options;
                        root.report-row(index, selected, options, clip.audio-tracks);
                    }
                    audio-updated(index, enabled) => {
                        let track = clip.audio-tracks[index];
                        clip.audio-tracks[index] = { name: track.name, info: track.info, enabled: enabled };
                    }
                    delete-requested => { root.delete-clip(index); }
                    compress-requested => { root.compress-clip(index); }
                    cancel-requested => { root.cancel-clip(index); }
                    copy-requested => { root.copy-requested(clip.output-path); }
                }

                add-videos-entry := Rectangle {
                    height: Math.max(9.5rem, add-videos-copy.min-height + 20px);
                    border-radius: 7.7px;
                    border-width: 1px;
                    border-color: add-videos-touch.has-hover ? Theme.accent : Theme.outline;
                    background: add-videos-touch.has-hover ? Theme.card-bg : transparent;
                    accessible-role: button;
                    accessible-label: "Add videos";
                    accessible-action-default => { root.add-videos-requested(); }

                    add-videos-copy := VerticalLayout {
                        padding: 10px;
                        alignment: center;
                        spacing: 6px;

                        Text {
                            text: "+";
                            color: Theme.accent;
                            font-size: 2rem;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Add videos";
                            color: Theme.text;
                            font-size: 1.23rem;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Choose files or drag and drop them here";
                            color: Theme.text-dim;
                            font-size: Theme.font-size-small;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    add-videos-touch := ClickFocusArea {
                        mouse-cursor: pointer;
                        clicked => { root.add-videos-requested(); }
                    }
                }
            }

            if root.marquee-active && root.selecting : Rectangle {
                x: Math.min(root.request.origin.x, root.request.position.x);
                y: Math.min(root.request.origin.y, root.request.position.y);
                width: Math.abs(root.request.position.x - root.request.origin.x);
                height: Math.abs(root.request.position.y - root.request.origin.y);
                background: Theme.accent.with-alpha(0.15);
                border-width: 1px;
                border-color: Theme.accent;
            }
        }
    }

    list-rail := ScrollRail {
        x: root.width - self.width;
        height: root.height;
        content-y <=> list-scroll.content-y;
        visible-height: list-scroll.visible-height;
        content-height: list-scroll.content-height;
    }
}
