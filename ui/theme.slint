export global Theme {
    in-out property <color> window-bg: #292D3E;
    in-out property <color> header-bg: #363A4C;
    in-out property <color> card-bg: #363A4C;
    in-out property <color> segment-bg: Theme.card-bg;
    in-out property <color> segment-selected: #4B5263;
    in-out property <color> segment-hover: #3E4452;
    in-out property <color> accent: #C792EA;
    in-out property <color> accent-hover: #E1ACFF;
    in-out property <color> text: #BFC7D5;
    in-out property <color> text-dim: Theme.text.with-alpha(0.85);
    in-out property <color> text-on-accent: Theme.window-bg;
    in-out property <color> divider: Theme.window-bg;
    in-out property <color> outline: #697098;
    in-out property <color> field-bg: Theme.window-bg;
    in-out property <color> badge-pending-bg: Theme.badge-pending-text.with-alpha(0.12);
    in-out property <color> badge-pending-text: #FFCB6B;
    in-out property <color> badge-ready-bg: Theme.badge-ready-text.with-alpha(0.12);
    in-out property <color> badge-ready-text: #82B1FF;
    in-out property <color> success: #C3E88D;

    in-out property <length> radius-control: 5.4px;
    in-out property <length> radius-pill: 4.5px;
    in-out property <length> field-height: 31px;
}
